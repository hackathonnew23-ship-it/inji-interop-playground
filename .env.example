# Inji Certify issuer metadata (path differs per deployment; check yours)
CERTIFY_META_URL=http://localhost:8091/v1/certify/issuance/.well-known/openid-credential-issuer
# Any third-party OpenID4VCI issuer, e.g. a public wwWallet or other test issuer
EXT_ISSUER_META_URL=https://issuer-test.uoa.gr/.well-known/openid-credential-issuer
# Inji Verify verify-service base URL (the one exposing /vp-request)
VERIFY_URL=http://localhost:8082/v1/verify
VERIFY_CLIENT_ID=inji-interop-playground
VERIFY_FORMATS=ldp_vc
PORT=3000
